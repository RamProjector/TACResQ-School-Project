# Local Laravel backend settings. Copy to .env and generate a unique APP_KEY.
APP_KEY=
APP_ENV=local
APP_DEBUG=true
LOG_CHANNEL=stderr

# Browser-safe Supabase settings used by the dashboard at /dispatch/.
# These are intentionally exposed to the browser; never substitute a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Trusted FCM worker only; never expose these through the dashboard or Android app.
SUPABASE_SECRET_KEY=
FCM_PROJECT_ID=
# google/auth uses ADC. Point this at a private secret file or platform ADC; never commit a JSON key.
GOOGLE_APPLICATION_CREDENTIALS=
FCM_BATCH_LIMIT=100
FCM_HTTP_TIMEOUT=8

# Optional private self-hosted OSRM service. Use an internal hostname, never a public route API.
OSRM_BASE_URL=
# Independent backend kill switch. Keep false until provider, privacy, and device QA gates pass.
ROUTE_PREVIEW_ENABLED=false
# Select exactly one server-side provider when routing is enabled: geoapify or osrm.
ROUTE_PROVIDER=geoapify
